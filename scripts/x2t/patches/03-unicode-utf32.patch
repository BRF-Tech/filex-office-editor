+// filex-office-editor (BRF Tech, 2026-10-10): wchar_t to ICU's UTF-16 and back.
+// Where wchar_t holds UTF-32 (Linux, WebAssembly) this uses ICU's UTF-32
+// functions. u_strFromWCS and u_strToWCS rely on ICU knowing that wchar_t is
+// UTF-32; built with emscripten it does not, goes through the C library's
+// multibyte functions in the current locale, and in the "C" locale every
+// letter outside ASCII fails (U_ILLEGAL_ARGUMENT_ERROR). fromUnicode then
+// fell back to keeping each character's low byte (U+015E, a capital S with
+// cedilla, became "^" in a txt or csv written as UTF-8).
+#include <cwchar>
+static void WcsToUChars(UChar* pDst, int32_t nDstCapacity, int32_t* pDstLength, const wchar_t* pSrc, int32_t nSrcLength, UErrorCode* pStatus)
+{
+#if WCHAR_MAX > 0xFFFF
+	u_strFromUTF32WithSub(pDst, nDstCapacity, pDstLength, (const UChar32*)pSrc, nSrcLength, 0xFFFD, NULL, pStatus);
+#else
+	u_strFromWCS(pDst, nDstCapacity, pDstLength, pSrc, nSrcLength, pStatus);
+#endif
+}
+static void UCharsToWcs(wchar_t* pDst, int32_t nDstCapacity, int32_t* pDstLength, const UChar* pSrc, int32_t nSrcLength, UErrorCode* pStatus)
+{
+#if WCHAR_MAX > 0xFFFF
+	u_strToUTF32WithSub((UChar32*)pDst, nDstCapacity, pDstLength, pSrc, nSrcLength, 0xFFFD, NULL, pStatus);
+#else
+	u_strToWCS(pDst, nDstCapacity, pDstLength, pSrc, nSrcLength, pStatus);
+#endif
+}
